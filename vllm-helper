#!/usr/bin/env bash
# vllm-helper -- unified CLI for managing a single-model vLLM deployment.
# Everything here is a thin dispatcher to lib/*.sh; run `vllm-helper` with no
# arguments (or --help) for the full command reference.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"
cd "$VH_ROOT"

top_help() {
  cat <<EOF
vllm-helper -- manage a vLLM deployment on this machine (models, switching,
optional Coder Agents sync). Only one model is loaded at a time.

USAGE
  vllm-helper <command> [args]

COMMANDS
  list                     List saved model profiles
  switch <profile>         Switch to a saved profile (restarts the server)
  new <org/model-name>     Pull a brand-new HuggingFace model, save it as a
                           profile, and switch to it
  search <query>           Interactively search HuggingFace and pick a model
                           to pull and switch to (needs a real terminal)
  remove <profile>         Delete a profile (and its Coder model entry, if
                           Coder sync is configured)
  coder-sync <activate|register|remove> <profile>
                           Manually sync one profile's Coder model entry
                           (switch/new/remove already do this automatically)
  status                   Quick health check: service state, active model,
                           and whether the endpoint is responding

Run 'vllm-helper switch' (or new/remove) with no further arguments to see
the full reference for that command, including the saved profile list.

See README.md for the full picture: sizing new models, the optional Coder
sync mechanism, and troubleshooting.
EOF
}

[ $# -ge 1 ] || { top_help; exit 1; }
cmd="$1"; shift || true

case "$cmd" in
  list)       exec lib/switch.sh --list ;;
  switch)     exec lib/switch.sh "$@" ;;
  new)        exec lib/switch.sh --new "$@" ;;
  remove)     exec lib/switch.sh --remove "$@" ;;
  search)     exec lib/search.sh "$@" ;;
  coder-sync) exec lib/sync-coder.sh "$@" ;;
  start)      exec lib/start.sh ;;
  status)
    vh_load_config
    if [ "$SERVICE_SCOPE" = "user" ]; then
      echo "systemd:  $(systemctl --user is-active "$SERVICE_NAME" 2>&1)"
    else
      echo "systemd:  $(systemctl is-active "$SERVICE_NAME" 2>&1)"
    fi
    model=$(grep -m1 '^MODEL=' "$VH_ACTIVE_ENV" 2>/dev/null | cut -d= -f2-)
    profile=$(vh_active_profile)
    echo "profile:  ${profile:-unknown}"
    echo "model:    ${model:-unknown}"
    code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://localhost:$PORT/health" 2>/dev/null) || true
    code="${code:-000}"
    if [ "$code" == "200" ]; then
      echo "endpoint: healthy (http $code on port $PORT)"
    else
      echo "endpoint: not responding (http $code on port $PORT) -- still loading, or check the service logs"
    fi
    ;;
  --help|-h|help) top_help ;;
  *)
    echo "Unknown command: $cmd"
    echo
    top_help
    exit 1
    ;;
esac
