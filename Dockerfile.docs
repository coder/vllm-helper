# The public docs website (cmd/vllm-helper-docs), deployed on Railway.
#
# Railway service settings, set on the service rather than in a config file:
#   Dockerfile path  Dockerfile.docs
#   Healthcheck      /healthz
#   Watch paths      docs/**, internal/web/**, cmd/vllm-helper-docs/**,
#                    Dockerfile.docs, go.mod, go.sum
#   Variables        BASE_URL=https://vllm-helper-docs.up.railway.app
#
# That is a TEMPORARY domain: Railway's generated one, in use until the site
# has a permanent hostname. When it changes, update BASE_URL on the service and
# the docs links at the bottom of README.md. Set BASE_URL rather than relying
# on RAILWAY_PUBLIC_DOMAIN: a redeploy reuses the variables of the deploy it
# copies, so after a domain rename that fallback keeps the old name.
#
# Local preview:
#   docker build -f Dockerfile.docs -t vllm-helper-docs .
#   docker run --rm -p 8080:8080 -e PORT=8080 vllm-helper-docs

FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/vllm-helper-docs ./cmd/vllm-helper-docs

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/vllm-helper-docs /vllm-helper-docs
ENTRYPOINT ["/vllm-helper-docs"]
