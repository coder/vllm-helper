# Status: TESTED AND WORKING (verified 2026-07-30 on a GB10, 128GB unified memory)
# Needs all three flags below or tool_choice=auto requests fail with HTTP 400.
# Flags are from the model's own HF card. Do NOT remove quotes around
# EXTRA_ARGS -- unquoted multi-word values break .env sourcing (bash treats
# the second word as a command to run).
MODEL=poolside/Laguna-S-2.1-NVFP4
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.85
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser poolside_v1 --reasoning-parser poolside_v1"
