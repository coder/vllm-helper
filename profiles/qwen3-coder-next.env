# Status: TESTED AND WORKING (verified 2026-07-29 on a GB10, 128GB unified memory)
# 80B total / 3B active MoE, coding-focused, no thinking mode.
# ~75GB on disk, ~24GB KV cache headroom at 131072 context.
MODEL=Qwen/Qwen3-Coder-Next-FP8
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.85
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_coder"
