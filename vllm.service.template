# Template for the vllm-helper systemd unit. install.sh renders this
# (replacing @USER_LINE@, @ROOT@, @WANTED_BY@) and installs it at:
#   system scope:  /etc/systemd/system/vllm.service
#   user scope:    ~/.config/systemd/user/vllm.service
# Don't edit the installed copy by hand -- edit this and re-run install.sh.
[Unit]
Description=vLLM OpenAI-compatible server (active model set via vllm-helper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@USER_LINE@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/vllm-helper start
Restart=on-failure
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=@WANTED_BY@
