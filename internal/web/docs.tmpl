{{define "docsSidebar"}}<ul class="docs-nav">
  {{range .}}
  <li>
    <a href="{{.Route}}"{{if .Current}} aria-current="page"{{end}}>{{.Title}}</a>
    {{if .Children}}{{template "docsSidebar" .Children}}{{end}}
  </li>
  {{end}}
</ul>{{end}}

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{{.Title}} &middot; vllm-helper</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body>
    <header class="bar">
      <span class="wordmark">vllm&#8209;helper</span>
      <span class="bar-host">{{.Host}}</span>
      <nav class="tabs">
        <a class="tab" href="/">Machine</a>
        <a class="tab" href="/models">Add model</a>
        <a class="tab" href="/docs" aria-current="page">Docs</a>
      </nav>
      <span class="bar-build">{{.Build}}</span>
    </header>

    <div class="docs">
      <aside class="docs-side">
        <p class="docs-side-title">Documentation</p>
        {{.Nav}}
      </aside>

      <main class="docs-main">
        <article class="docs-content">
          <h1 class="docs-title">{{.Title}}</h1>
          {{if .Description}}<p class="docs-description">{{.Description}}</p>{{end}}
          {{.Body}}
        </article>

        <nav class="docs-prevnext" aria-label="Adjacent pages">
          {{with .Prev}}<a class="docs-prev" href="{{.Route}}">&larr; {{.Title}}</a
          >{{else}}<span></span>{{end}}
          {{with .Next}}<a class="docs-next" href="{{.Route}}">{{.Title}} &rarr;</a
          >{{else}}<span></span>{{end}}
        </nav>
      </main>

      {{if .TOC}}
      <aside class="docs-toc" aria-label="On this page">
        <p class="docs-toc-title">On this page</p>
        <ul>
          {{range .TOC}}
          <li class="docs-toc-h{{.Level}}"><a href="#{{.ID}}">{{.Text}}</a></li>
          {{end}}
        </ul>
      </aside>
      {{end}}
    </div>
  </body>
</html>
