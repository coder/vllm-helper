            "upstream": "applied",
            "why": "The mod is opt-in and only serves speculative decoding, which is off here. The stock loader in this image is already correct for the checkpoint."
          },
          {
            "setting": "num_speculative_tokens",
            "upstream": "6",
            "why": "6 is not a multiple of the checkpoint's dspark_block_size 5. Speculative decoding is left off and unmeasured: it costs 38% of KV cache and a third of concurrency, and its gains shrink under load."
          },
          {
            "setting": "max_model_len",
            "upstream": "auto",
            "ours": "262144",
            "why": "auto resolves to 1048576 on this checkpoint, which does not fit on two GB10s."
