                },
                "npu": {
                  "extra_args": [
                    "--speculative-config",
                    "{\"method\":\"mtp\",\"num_speculative_tokens\":1,\"enforce_eager\":true}"
                  ]
                }
              }
            },
            "dspark": {
              "variants": ["default", "dspark"],
              "args": [
                "--speculative-config",
                "{\"method\":\"dspark\",\"num_speculative_tokens\":7,\"draft_sample_method\":\"probabilistic\"}"
              ],
              "hardware_overrides": {
                "dgx_spark_gb10": {
                  "extra_args": [
                    "--speculative-config",
                    "{\"method\":\"dspark\",\"num_speculative_tokens\":5,\"draft_sample_method\":\"probabilistic\",\"attention_backend\":\"B12X_MLA_SPARSE\"}"
                  ]
                }
              }
            }
          }
        }
